{
  "name": "egon-mcp",
  "version": "0.1.0",
  "description": "MCP server for creating, editing, validating and rendering Egon.io domain stories",
  "type": "module",
  "private": true,
  "bin": {
    "egon-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "generate:icons": "node --disable-warning=ExperimentalWarning scripts/generate-icons.mjs",
    "prebuild": "npm run generate:icons",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "pretest": "npm run generate:icons",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "fast-xml-parser": "^5.12.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
