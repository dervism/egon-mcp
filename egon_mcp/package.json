{
  "name": "egon-mcp",
  "version": "0.1.1",
  "description": "MCP server for creating, editing, validating and rendering Egon.io domain stories",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "egon",
    "domain-storytelling",
    "domain-driven-design",
    "ddd"
  ],
  "homepage": "https://github.com/dervism/egon-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dervism/egon-mcp.git",
    "directory": "egon_mcp"
  },
  "bugs": {
    "url": "https://github.com/dervism/egon-mcp/issues"
  },
  "type": "module",
  "bin": {
    "egon-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "skill"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "generate:icons": "node --disable-warning=ExperimentalWarning scripts/generate-icons.mjs",
    "prebuild": "npm run generate:icons",
    "build": "node --disable-warning=ExperimentalWarning scripts/record-sources.mjs && tsc -p tsconfig.build.json && node scripts/finish-build.mjs",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "docs": "npm run build && node scripts/generate-docs.mjs",
    "prepack": "npm run build && node scripts/pack-extras.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "fast-xml-parser": "^5.12.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "license": "GPL-3.0-or-later"
}
